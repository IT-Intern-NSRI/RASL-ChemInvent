# --- Database (Neon Postgres) ---
# Create a free project at https://neon.tech, then copy both connection
# strings from its dashboard (Connection Details):
#   - DATABASE_URL: the *pooled* connection string (has "-pooler" in the
#     hostname) - this is what the running app uses.
#   - DIRECT_URL: the *unpooled* connection string - only `prisma migrate`
#     uses this one, since migrations need a direct connection.
# Both should end in ?sslmode=require - Neon requires TLS.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/chem_inventory?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/chem_inventory?sslmode=require"

# --- Better Auth ---
# Generate a real secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
