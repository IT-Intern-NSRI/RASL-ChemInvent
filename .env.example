# --- Database ---
# SQLite by default: a single file on disk, zero extra services to install
# or maintain. Good enough for a small internal tool with a handful of
# concurrent editors. See README.md for how to switch to PostgreSQL later
# if you outgrow it.
DATABASE_URL="file:./dev.db"

# --- Better Auth ---
# Generate a real secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
